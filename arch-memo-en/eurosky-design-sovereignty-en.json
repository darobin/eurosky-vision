{
  "title": "Designing for Sovereignty",
  "revisionId": "AD8KACQKrDKgp0s0Xm9PcOm_gMc768pVRgN4JV7QFTwdayJA-2ecgBTI8yobuyE4GZogGLvFF7yS6vXJp4cv-A",
  "suggestionsViewMode": "SUGGESTIONS_INLINE",
  "documentId": "1T0X3x8XI-xbXKmRkWUEq7_NY0XPD2yexKWzpPJ4jRfA",
  "tabs": [
    {
      "tabProperties": {
        "tabId": "t.0",
        "title": "Tab 1",
        "index": 0
      },
      "documentTab": {
        "body": {
          "content": [
            {
              "endIndex": 1,
              "sectionBreak": {
                "sectionStyle": {
